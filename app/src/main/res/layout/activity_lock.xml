<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="48dp"
    android:background="@color/bg" android:gravity="center">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⏳ 休息一下" android:textColor="@color/accent" android:textSize="48sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="刚才有题目答错了，先休息、看看书、活动一下吧。" android:textColor="@color/text" android:textSize="28sp" />
    <TextView android:id="@+id/tvCountdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="30:00" android:textColor="@color/text" android:textSize="72sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="倒计时结束后再答题，全部答对就能继续看。" android:textColor="@color/subtext" android:textSize="22sp" />
    <Button android:id="@+id/btnParentLock" android:layout_width="360dp" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:text="家长入口（PIN）" android:textSize="22sp"
        android:textColor="@color/text" android:background="@drawable/btn_bg" android:focusable="true" />
</LinearLayout>
