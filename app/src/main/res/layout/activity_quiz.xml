<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable root: on low-height TV screens (e.g. 960x540 / 720p emulators,
     where the visible height can be ~540dp) the fixed-size version overflowed
     and the last option (D) plus the parent button were cut off with no way to
     scroll to them. With a ScrollView, D-pad focus automatically scrolls the
     focused option into view, and sizes below are compact enough to fit
     720dp-tall screens without scrolling at all. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView android:id="@+id/tvQuizHead" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="答对全部6道题，才能继续看哦！" android:textColor="@color/accent" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvSubject" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="语文 · 第1/3题" android:textColor="@color/subtext" android:textSize="22sp" />
        <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:text="题目" android:textColor="@color/text" android:textSize="32sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <Button android:id="@+id/btnOpt0" style="@style/QuizBtn" />
            <Button android:id="@+id/btnOpt1" style="@style/QuizBtn" />
            <Button android:id="@+id/btnOpt2" style="@style/QuizBtn" />
            <Button android:id="@+id/btnOpt3" style="@style/QuizBtn" />
        </LinearLayout>

        <Button android:id="@+id/btnParentQuiz" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="14dp" android:text="家长入口（PIN）" android:textSize="18sp"
            android:textColor="@color/subtext" android:background="@drawable/btn_bg" android:focusable="true" />
    </LinearLayout>
</ScrollView>
