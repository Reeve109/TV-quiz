<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="44dp"
    android:background="@color/bg" android:gravity="center_horizontal">

    <TextView android:id="@+id/tvQuizHead" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="答对全部6道题，才能继续看哦！" android:textColor="@color/accent" android:textSize="34sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvSubject" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="语文 · 第1/3题" android:textColor="@color/subtext" android:textSize="26sp" />
    <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:gravity="center" android:text="题目" android:textColor="@color/text" android:textSize="40sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="760dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="26dp">
        <Button android:id="@+id/btnOpt0" style="@style/QuizBtn" />
        <Button android:id="@+id/btnOpt1" style="@style/QuizBtn" />
        <Button android:id="@+id/btnOpt2" style="@style/QuizBtn" />
        <Button android:id="@+id/btnOpt3" style="@style/QuizBtn" />
    </LinearLayout>

    <Button android:id="@+id/btnParentQuiz" android:layout_width="360dp" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="家长入口（PIN）" android:textSize="20sp"
        android:textColor="@color/subtext" android:background="@drawable/btn_bg" android:focusable="true" />
</LinearLayout>
