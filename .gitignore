# Build outputs
app/build/
build/
.gradle/
out/

# Local config (contains local SDK path)
local.properties

# Signing keys — never commit real keystores
*.keystore
*.jks
# Note: the manual build script generates ONE persistent debug keystore at
# .keystore/debug.keystore on first use and reuses it for every build, so
# successive APKs share a signature and can be installed as updates. It is a
# local build artifact, not a release key, and is excluded by the rules above.

# IDE
.idea/
*.iml
.classpath
.project
.settings/

# OS / misc
.DS_Store
*.idsig
TVQuiz.apk
app/build/outputs/
